[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://world/Island.gd" id="1_island"]
[ext_resource type="Shader" path="res://world/sky.gdshader" id="2_sky"]
[ext_resource type="Script" path="res://world/Sol.gd" id="3_sol"]

[sub_resource type="ShaderMaterial" id="SkyMat"]
shader = ExtResource("2_sky")

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")
; 64x64 de radiance: a luz de ambiente vem do ceu INTEIRO, nao precisa de nitidez.
; MEDIDO no 4.4.1: sem esta linha o modo AUTOMATICO ve' o TIME das nuvens do
; sky.gdshader, escolhe REALTIME, e o Godot avisa que "Realtime Skies can only
; use a radiance size of 256" — ou seja, o mobile pagava um cubemap 256 refeito
; TODO frame sem ninguem ter pedido. INCREMENTAL (2) respeita os 64 e espalha a
; atualizacao por varios frames; as nuvens andam devagar, ninguem ve' o atraso.
process_mode = 2
radiance_size = 1

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
; 85% ceu + 15% de um azul frio: a sombra deixa de ser cinza morto e vira
; azul-noite arcano (GDD §10). Sombra com COR, nunca com falta de luz.
ambient_light_source = 3
ambient_light_color = Color(0.44, 0.53, 0.85, 1)
ambient_light_sky_contribution = 0.85
ambient_light_energy = 0.3
; ACES (3): rolloff de highlight e contraste de midtone = o salto de realismo
; mais barato que existe (mesmo passe de post, zero custo extra vs Filmic).
; ACES escurece — a exposicao sobe junto p/ manter o entardecer aberto.
tonemap_mode = 3
tonemap_exposure = 0.78
tonemap_white = 6.0
; correcao final: um empurrao de contraste e saturacao. E' um MAD no passe de
; tonemap que ja roda; nao adiciona passe nenhum.
adjustment_enabled = true
adjustment_brightness = 1.0
adjustment_contrast = 1.24
adjustment_saturation = 0.96
glow_enabled = true
glow_intensity = 0.4
glow_strength = 1.0
glow_bloom = 0.0
glow_blend_mode = 1
glow_hdr_threshold = 1.1
; NEVOA POR PROFUNDIDADE (fog_mode 1), nao exponencial. Medido aqui: a
; exponencial forte o bastante p/ dissolver o mar (200m+) ja' lavava o chao a 20m
; — e num jogo de combate lavar os primeiros 20m e' perder leitura de alvo.
; A de profundidade tem um COMECO: ate' 45m nada, dai' sobe em curva ate' sumir
; no ceu aos 300m. Perto limpo, longe com ar. Custo: ~1 lerp por pixel.
; A camada BAIXA (abaixo de y=6) poe bruma no mar e na cava do alagado sem tocar
; no topo das colinas — leitura de altura de graca.
; ponytail: nevoa VOLUMETRICA nao existe no renderer mobile; nem tente.
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.93, 0.76, 0.55, 1)
fog_light_energy = 1.0
fog_sun_scatter = 0.22
fog_density = 1.0
fog_aerial_perspective = 0.4
fog_sky_affect = 0.6
fog_height = 6.0
fog_height_density = 0.02
; G5 — O DEFEITO MAIS CARO DA VISTA AEREA, e ele so' apareceu quando a tomada de
; 200 m foi renderizada e OLHADA: com fim aos 220 m, o chao visto da altura da
; queda estava a 200 m da camera e portanto 81% engolido pela nevoa. O quadro
; drop200 do baseline e' um BORRAO CARAMELO uniforme — nao da' pra escolher onde
; pousar num quadro onde nao existe nada. E a fase nova comeca exatamente ai'.
; Numeros novos, com a conta: t = ((d - begin)/(end - begin))^curve.
;   d=200 m (o chao, visto la' de cima) -> 8% de nevoa: le' com ar, nao apagado.
;   d=280 m (a costa oposta, visto do chao) -> 20%: perspectiva aerea de verdade.
;   d>520 m (o mar aberto) -> 100%: o mar continua morrendo no ceu, que era o
;   motivo do 220 original.
; O comeco subiu de 34 para 55 m porque o mapa dobrou: 34 m era "longe" numa ilha
; de 76 m de raio e e' "do outro lado da clareira" numa de 132.
fog_depth_curve = 2.2
fog_depth_begin = 55.0
fog_depth_end = 520.0

[node name="Island" type="Node3D"]
script = ExtResource("1_island")

; SOL DO ENTARDECER. -30 graus de altura (era -35): sombra mais LONGA, e sombra
; longa e' o que le' relevo — o barranco, a coluna e o mago ganham chao.
; ORTOGONAL (1 split) de proposito: PSSM com 2 splits redesenha TODO o casters
; duas vezes por frame, e o ganho nao paga no ARM64. Com max_distance em 60m e
; atlas 2048 o texel sai ~6cm, o suficiente pro que o jogador olha.
; 26/08: os 60m aqui sao o REPOUSO, com o mago no chao. Quem cai do castelo ve
; a ilha de 200m de altura, e a 60m de alcance ela nao tinha UMA sombra — o
; numero foi calibrado quando a ilha era 180m e ninguem caia do ceu. world/Sol.gd
; abre o alcance junto com a altura e o fecha de volta ao pousar, mantendo o
; texel fino no chao. Continua 1 split: nada disso reabre PSSM.
; fade_start 0.85: a sombra MORRE em rampa nos ultimos 15% em vez de cortar numa
; linha reta atravessando a ilha (o corte seco e' o defeito classico do PSSM).
[node name="Sun" type="DirectionalLight3D" parent="."]
rotation = Vector3(-0.52, 0.72, 0.0)
light_color = Color(1, 0.86, 0.63, 1)
light_energy = 1.55
shadow_enabled = true
shadow_bias = 0.04
shadow_normal_bias = 1.4
shadow_opacity = 0.92
directional_shadow_mode = 0
directional_shadow_max_distance = 60.0
directional_shadow_fade_start = 0.85
script = ExtResource("3_sol")

[node name="Env" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

; SPAWNS — 14 marcadores, 2 por POI (o Main.gd coleta o grupo "spawn"). Com a
; ilha em 300 m eles deixaram de ser "espalhados": cada par fica na BOCA de um
; POI, nunca dentro d'agua e nunca no meio da mata fechada. O y aqui e' chute —
; _snap_spawns() gruda todo mundo em height()+0.3 no boot.
[node name="SpawnForestA" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(-48, 4, -54)

[node name="SpawnForestB" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(-74, 4, -80)

[node name="SpawnLakeA" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(43, 4, 30)

[node name="SpawnLakeB" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(75, 4, 62)

[node name="SpawnRuinsA" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(63, 10, -73)

[node name="SpawnRuinsB" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(54, 10, -62)

[node name="SpawnMarshA" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(-52, 2, 48)

[node name="SpawnMarshB" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(-86, 2, 76)

; PICO: os dois em cima da mesa. E' o unico spawn de terreno ALTO do mapa —
; quem nasce ali comeca com visao e com a unica encosta subivel nas costas.
[node name="SpawnPeakA" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(12, 32, 84)

[node name="SpawnPeakB" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(20, 32, 90)

[node name="SpawnDunesA" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(10, 3, -98)

[node name="SpawnDunesB" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(-10, 3, -88)

[node name="SpawnValleyA" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(0, 2, 12)

[node name="SpawnValleyB" type="Marker3D" parent="." groups=["spawn"]]
position = Vector3(-14, 2, -18)
