; ARKANA 3D — Godot 4.4 · 3a pessoa · regua Spellbreak · Android
; Dono deste arquivo: COORDENADOR. Raias nao editam; pedem.
config_version=5

[application]
config/name="Arkana"
; A porta de entrada e' o MENU (R18) — a partida e' carregada pelo botao JOGAR.
run/main_scene="res://menu/Menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
; MARCA (26/08). O icone era o RETRATO da Pyra: um corpo inteiro espremido num
; quadrado de 96 px, ilegivel na gaveta do aparelho e amarrado a UM personagem
; num jogo de 20. Agora e' o Selo — o mesmo desenho da tela de titulo, gerado
; por menu/_marca.gd a partir de menu/Selo.gd, para nunca divergir dele.
config/icon="res://menu/art/marca/icone-192.png"
; ABERTURA. Sem estas linhas o motor mostra o LOGO DO GODOT: ate' 26/08 a
; primeira coisa que o jogador via ao abrir o Arkana nao era o Arkana.
; bg_color e' Estilo.NOITE_FUNDA (#05070F), o mesmo fundo da tela de titulo,
; para a splash emendar no menu sem piscar cor.
boot_splash/bg_color=Color(0.0196, 0.0275, 0.0588, 1)
boot_splash/image="res://menu/art/marca/splash-512.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]
Balance="*res://core/Balance.gd"
Bus="*res://core/Bus.gd"
Sfx="*res://audio/Sfx.gd"

[display]
; BASE 20:9 (nao 16:9) — mudanca da R19.2, raia UI, medida no aparelho.
; Com stretch aspect="expand" o Godot NAO estica o canvas: ele o AUMENTA no eixo
; que sobra. Medido no 4.4.1 com base 1280x720 numa janela 20:9, o canvas real
; sai 1600x720. So' que Safe.gd e Dp.gd convertem px fisico -> px de canvas
; dividindo pela base DESTE arquivo (1280), entao toda margem horizontal sai
; ~20% menor que o devido — justo o eixo onde mora o notch em paisagem.
; Com a base em 1600x720 o canvas de um 20:9 bate exato (erro 0) e o pior caso
; da faixa 19.5:9-21:9 cai para ~5%. Nada mais no projeto le' estes numeros
; alem de Safe.gd/Dp.gd (conferido por grep); a UI e' toda ancorada.
window/size/viewport_width=1600
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
; Sem esta linha o export Android FALHA EM SILENCIO (erro sem mensagem no 4.4.1)
; — e' a linha que o proprio wizard do Godot escreve em projetos Mobile. O
; build_apk.sh falha cedo apontando para ca' se alguem a remover.
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="mobile"
; VALOR INICIAL, antes do primeiro Config.aplicar(): as Configuracoes mandam
; nele em runtime (preset de Qualidade). Ajustar aqui so' muda o primeiro frame.
anti_aliasing/quality/msaa_3d=1

; --- pedidos da raia MUNDO (R20), aplicados pelo COORDENADOR ---
; Fixa o atlas de sombra do mobile: hoje e' o default, mas se alguem subir o
; valor de desktop o mobile vai junto sem querer.
lights_and_shadows/directional_shadow/size.mobile=2048
; PCF 1 (4 taps): sombra dura de 1 split em 2048 escadinha na borda. Se pesar
; no aparelho, voltar a 0 — e' o primeiro botao a mexer.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
; O mundo tem ZERO luz posicional com sombra: o atlas default e' VRAM parada.
lights_and_shadows/positional_shadow/atlas_size.mobile=512

; --- ESCALA DE RENDER: NAO MEXER AQUI ---
; A alavanca de emergencia de fps virou o preset "Baixa" das Configuracoes
; (menu/Config.gd -> QUALIDADE), aplicado em RUNTIME via Viewport.scaling_3d_scale.
; Ligar aqui seria sobrescrito no primeiro Config.aplicar() do boot.
; Para mudar a escala, mexa em Config.QUALIDADE.
