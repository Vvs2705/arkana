<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ desenha a splash DO SISTEMA antes da janela do app, e ela só
      usa android:windowBackground quando ele é uma cor chapada. O nosso é um
      layer-list (cor + Selo), então sem a linha abaixo o sistema cairia no
      colorBackground do tema e piscaria claro em todo aparelho moderno.
      O ícone que o sistema desenha por cima é o adaptativo — o próprio Selo.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">@color/arkana_night</item>
    </style>
</resources>
