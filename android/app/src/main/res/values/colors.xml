    <color name="arkana_earth">#A8763E</color>
    <color name="arkana_wind">#8FE8C9</color>
    <color name="arkana_lightning">#F5D90A</color>

    <color name="colorPrimary">#0B1026</color>
    <color name="colorPrimaryDark">#05070F</color>
    <color name="colorAccent">#F0C75E</color>
