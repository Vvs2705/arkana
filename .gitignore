# Godot
godot/.godot/
godot/build/
*.apk
*.aab

# Roblox / Rojo
roblox/build/

# Arte dos personagens — o ATELIE nao vai para o git, o RETRATO vai.
# As folhas de concept (8 vistas por mago, ~1,9MB cada = 307MB no elenco) sao
# materia-prima da modelagem 3D e vivem so' no disco. O que o jogo carrega e'
# godot/menu/art/NN.png (512px), esse sim versionado. Backup: os .zip da entrega
# original do Diretor, guardados por ele fora do repositorio.
personagens/*/arte/_originais/
# Zips de entrega em QUALQUER profundidade — a regra antiga era personagens/*.zip
# e nao pegava subpasta, foi assim que 293MB ficaram expostos em 24/08.
personagens/**/*.zip

# Logs e caches
logs/
*.log
.cache/
__pycache__/
*.pyc

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Sistema operacional
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Segredos e assinatura
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
keystore.properties

# Modelos 3D — a OFICINA nao vai para o git, o PRODUTO vai.
# A pasta de trabalho de cada personagem (malha crua da Meshy, FBX, texturas
# soltas, animacoes separadas) pesa ~114MB so' na Pyra e e' REGENERAVEL:
#   python tools/meshy/meshy.py tudo 01-pyra && python tools/meshy/montar_glb.py 01-pyra pyra
# O que o jogo carrega de fato e' godot/characters/modelos/<nome>.glb, que fica
# versionado. Se um dia o elenco inteiro entrar, migrar esses .glb para Git LFS
# (docs/PASSOS_GRAFICOS.md secao 6).
godot/characters/modelos/*/
!godot/characters/modelos/*.glb
