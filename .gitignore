.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
keystore.properties

# Modelos 3D — a OFICINA nao vai para o git, o PRODUTO vai.
# A pasta de trabalho de cada personagem (malha crua da Meshy, FBX, texturas
# soltas, animacoes separadas) pesa ~114MB so' na Pyra e e' REGENERAVEL:
#   python tools/meshy/meshy.py tudo 01-pyra && python tools/meshy/montar_glb.py 01-pyra pyra
# O que o jogo carrega de fato e' godot/characters/modelos/<nome>.glb, que fica
# versionado. Se um dia o elenco inteiro entrar, migrar esses .glb para Git LFS
# (docs/PASSOS_GRAFICOS.md secao 6).
mobile-godot/godot/characters/modelos/*/
!mobile-godot/godot/characters/modelos/*.glb
# Originais do Meshy por peca de cenario (castelo hi-poly 1,9 M tris, luvas,
# bau...): 505 MB fora do git. A versao de jogo (decimada) e' o que se versiona.
arte/cenario/*/origem/

# Peças 3D originais do Meshy (3 M de faces, 1,1 GB). Materia-prima pesada e
# rebaixavel do workspace da Meshy; o git guarda a versao de jogo, nao esta.
arte/cenario/ilha-fraturada/_originais-3d/*.glb

# Ilha do Documento Mestre no Blender (~110 MB): reproduzivel por arte/tools/ilha_para_blender.py; nao vai para o git
arte/cenario/documento-mestre/*.blend
arte/cenario/documento-mestre/*.blend1

# pacotes CC0 baixados por arte/tools/cc0.py (grandes, reproduziveis)
arte/cenario/cc0/

# Trava local do Claude Code
.claude/scheduled_tasks.lock
