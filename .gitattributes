# Game-ready character assets. Keep this scoped so existing concept art PNGs
# are not silently migrated to LFS by future edits.
mobile-godot/godot/characters/modelos/*.glb filter=lfs diff=lfs merge=lfs -text
mobile-godot/godot/characters/modelos/*.GLB filter=lfs diff=lfs merge=lfs -text
mobile-godot/godot/characters/modelos/*.png filter=lfs diff=lfs merge=lfs -text
mobile-godot/godot/characters/modelos/*.PNG filter=lfs diff=lfs merge=lfs -text
mobile-godot/godot/characters/modelos/*.ktx2 filter=lfs diff=lfs merge=lfs -text
mobile-godot/godot/characters/modelos/*.KTX2 filter=lfs diff=lfs merge=lfs -text

# Concept art dos 20 magos (8 vistas cada, 306 MB). Decisao do Diretor em
# 26/08/2026: elas passam a viver NO repositorio, via LFS. Antes existiam em UM
# lugar so' no disco dele, sem copia — os .zip da entrega foram apagados na
# higienizacao apos conferencia MD5, e isso deixou a materia-prima da modelagem
# 3D sem backup nenhum. LFS resolve o risco de perda e da' historico.
# CUSTO REAL, para ninguem se surpreender: o repo passa a puxar ~350 MB de LFS
# num clone limpo. A cota gratuita do GitHub e' 1 GB de armazenamento e 1 GB de
# banda por mes — cabe, mas sao ~3 clones limpos por mes antes de estourar a
# banda. Se estourar, a saida e' comprar data pack ou mover para storage externo.
arte/personagens/**/_originais/*.png filter=lfs diff=lfs merge=lfs -text
arte/personagens/**/_originais/*.PNG filter=lfs diff=lfs merge=lfs -text

# Concept art de CENARIO aprovada em 26/08 (55 pecas: castelo, luvas, bau,
# ruinas, torre, altar) — mesma decisao das 160 referencias de personagens:
# arte versionada no LFS. Novo total de LFS ~470 MB; a cota gratis (1 GB de
# armazenamento / 1 GB de banda por mes) passa a render ~2 clones limpos por
# mes. Estourou: data pack ou storage externo (nao ha' terceira saida).
arte/cenario/**/*.png filter=lfs diff=lfs merge=lfs -text
arte/cenario/**/*.PNG filter=lfs diff=lfs merge=lfs -text

# Modelos de JOGO do cenario (decimados do Meshy pelo Blender, 26/08): estes
# ENTRAM no APK e no git via LFS. ~46 MB no total com texturas 2K embutidas.
mobile-godot/godot/world/modelos/*.glb filter=lfs diff=lfs merge=lfs -text
mobile-godot/godot/gameplay/modelos/*.glb filter=lfs diff=lfs merge=lfs -text

# Kit esculpido do cenario (Meshy -> Blender). Mesmo motivo dos personagens:
# binario grande, e o que precisa sobreviver e' o codigo que planta, nao o .glb.
mobile-godot/godot/world/modelos/**/*.glb filter=lfs diff=lfs merge=lfs -text

# A raiz separa DECISAO (design/), MATERIA-PRIMA (arte/) e as implementacoes
# (mobile-unity/, mobile-godot/, roblox/). Se um binario grande aparecer fora
# destes padroes, ele entra no git como blob e NAO tem volta barata.
arte/**/*.glb filter=lfs diff=lfs merge=lfs -text
arte/**/*.GLB filter=lfs diff=lfs merge=lfs -text
arte/**/*.fbx filter=lfs diff=lfs merge=lfs -text
arte/**/*.FBX filter=lfs diff=lfs merge=lfs -text

# Unity: binarios de asset em LFS; .meta, cenas, prefabs e materiais em TEXTO
# (Force Text no editor) para o diff e o merge funcionarem.
mobile-unity/**/*.fbx filter=lfs diff=lfs merge=lfs -text
mobile-unity/**/*.glb filter=lfs diff=lfs merge=lfs -text
mobile-unity/**/*.png filter=lfs diff=lfs merge=lfs -text
mobile-unity/**/*.wav filter=lfs diff=lfs merge=lfs -text
mobile-unity/**/*.ogg filter=lfs diff=lfs merge=lfs -text
mobile-unity/**/*.bytes filter=lfs diff=lfs merge=lfs -text
mobile-unity/**/*.unity text eol=lf
mobile-unity/**/*.prefab text eol=lf
mobile-unity/**/*.asset text eol=lf
mobile-unity/**/*.mat text eol=lf
mobile-unity/**/*.meta text eol=lf
